# PATH 설정

{{ if eq .chezmoi.os "darwin" }}
if [ -z "${HOMEBREW_SHELLENV_LOADED:-}" ] && [ -x "{{ .homebrewPrefix }}/bin/brew" ]; then
    eval "$({{ .homebrewPrefix }}/bin/brew shellenv)"
    export HOMEBREW_SHELLENV_LOADED=1
fi

# 중첩 로그인 셸은 shellenv를 건너뛰고, path_helper는 시스템 경로를 앞으로 옮긴다.
# 로그인 셸은 첫 셸과 같은 ~/.local/bin, Homebrew, 시스템 경로 순서로 되돌린다.
# 비로그인 하위 셸은 부모의 PATH 순서를 그대로 쓴다.
if [[ -o login ]] && [ -d "{{ .homebrewPrefix }}/bin" ]; then
    path=("$HOME/.local/bin" "{{ .homebrewPrefix }}/bin" "{{ .homebrewPrefix }}/sbin" "${path[@]}")
    typeset -U path
    export PATH
fi
{{ end }}

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
