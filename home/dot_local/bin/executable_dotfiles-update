#!/usr/bin/env bash
# Fetch, apply, and verify dotfiles when invoked by its calendar schedule.

set -euo pipefail

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/logs"
log_file="$log_dir/update-$(date +%Y%m%d-%H%M%S)-$$.log"
(
    umask 077
    mkdir -p "$log_dir"
    : > "$log_file"
)
exec 5>&1 6>&2
log_pipe="$log_file.pipe"
mkfifo -m 600 "$log_pipe"
(
    trap '' HUP INT TERM
    exec tee -a "$log_file" < "$log_pipe"
) &
log_pid=$!
exec > "$log_pipe" 2>&1
rm "$log_pipe"

finish_log() {
    local exit_code=$?
    printf '[dotfiles-update][end] %s exit_code=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$exit_code"
    exec 1>&5 2>&6 5>&- 6>&-
    wait "$log_pid" || true
    exit "$exit_code"
}
trap finish_log EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
printf '[dotfiles-update][start] %s log=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$log_file"

if ! command -v chezmoi >/dev/null 2>&1; then
    echo "[dotfiles-update][error] chezmoi not found" >&2
    exit 1
fi

source_path="$(chezmoi source-path)"
source_root="$(git -C "$source_path" rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$source_root" ] && [ -n "$(git -C "$source_root" status --porcelain)" ]; then
    echo "[dotfiles-update][error] source repository has local changes: $source_root" >&2
    echo "[dotfiles-update][error] commit, stash, or discard them before automatic update" >&2
    exit 1
fi

echo "[dotfiles-update] fetching and applying source updates"
chezmoi update --no-tty --force

echo "[dotfiles-update] verifying managed targets"
chezmoi verify
echo "[dotfiles-update] complete"
